# Copie este arquivo para ".env" (cp .env.example .env) e ajuste os
# valores se quiser — os padrões abaixo já funcionam com o
# docker-compose.yml deste projeto sem precisar mudar nada.

PORT=3000
NODE_ENV=development

# --- Banco de dados (Postgres) ---
# DB_HOST=db      -> quando a API/Worker rodam DENTRO do Docker (padrão,
#                    "db" é o nome do serviço no docker-compose.yml)
# DB_HOST=localhost -> quando você roda a API/Worker fora do Docker
#                      (ex.: "npm run dev" direto na sua máquina), com o
#                      Postgres containerizado expondo a porta 5432
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASS=postgres
DB_NAME=juris_db

# --- Redis (fila BullMQ) ---
# Mesma lógica do DB_HOST acima: "redis" dentro do Docker, "localhost"
# fora dele. Ver a Fase 8 do guia (Estudos/) para o bug real que
# aconteceu neste projeto quando o serviço "api" do docker-compose.yml
# não tinha essa variável configurada corretamente.
REDIS_HOST=redis
REDIS_PORT=6379

# Quantos jobs o Worker processa em paralelo (Fase 4)
LAWSUIT_SYNC_CONCURRENCY=5

# --- Dashboard administrativo (Bull Board, Fase 4.3) ---
# Protege http://localhost:3000/admin/queues com HTTP Basic Auth.
# TROQUE estes valores antes de publicar em qualquer lugar que não seja
# a sua máquina local.
ADMIN_USER=admin
ADMIN_PASS=troque_essa_senha
